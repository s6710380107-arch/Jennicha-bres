rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 's6710380107@pkru.ac.th' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isModeratorOrAdmin() {
      return isAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['moderator', 'admin']
      );
    }

    function isUserActive() {
      return isSignedIn() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'suspended'
      );
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles
    match /users/{userId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId
        && (isAdmin() || incoming().role == 'member')
        && incoming().status == 'active';
      allow update: if isSignedIn() && isValidId(userId) && (
        isAdmin() ||
        (request.auth.uid == userId && !incoming().diff(existing()).affectedKeys().hasAny(['role', 'status']))
      );
      allow delete: if isAdmin();
    }

    // Educational resources
    match /resources/{resourceId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isUserActive() && isValidId(resourceId)
        && incoming().authorId == request.auth.uid
        && incoming().title is string && incoming().title.size() <= 200
        && incoming().description is string && incoming().description.size() <= 5000;
      allow update: if isSignedIn() && isValidId(resourceId) && (
        (isUserActive() && existing().authorId == request.auth.uid && incoming().authorId == existing().authorId) ||
        isModeratorOrAdmin() ||
        (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['viewCount', 'likesCount']))
      );
      allow delete: if isSignedIn() && isValidId(resourceId) && (
        (existing().authorId == request.auth.uid) ||
        isModeratorOrAdmin()
      );
    }

    // Bookmarks / Favorites
    match /favorites/{favoriteId} {
      allow get: if isSignedIn() && isValidId(favoriteId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(favoriteId) && incoming().userId == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && isValidId(favoriteId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // Abuse / Issue Reports
    match /reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && (existing().reporterId == request.auth.uid || isModeratorOrAdmin());
      allow list: if isSignedIn() && isModeratorOrAdmin();
      allow create: if isSignedIn() && isValidId(reportId) && incoming().reporterId == request.auth.uid && incoming().status == 'pending';
      allow update: if isModeratorOrAdmin();
      allow delete: if isAdmin();
    }

    // Audit logs for moderation
    match /moderationLogs/{logId} {
      allow get, list: if isModeratorOrAdmin();
      allow create: if isModeratorOrAdmin() && incoming().performedByUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Website settings
    match /settings/{settingId} {
      allow get: if true;
      allow list: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Admins registry
    match /admins/{adminId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
